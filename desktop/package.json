{
  "name": "aurestar-desktop",
  "version": "1.0.0",
  "description": "Aurestar Windows desktop study planner",
  "private": true,
  "main": "main.cjs",
  "author": "Aurestar",
  "scripts": {
    "prestart": "npm run prepare-assets",
    "start": "electron .",
    "prepare-assets": "node prepare-assets.cjs",
    "dist": "npm run prepare-assets && electron-builder --win nsis portable",
    "dist:nsis": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.aurestar.desktop",
    "productName": "Aurestar",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "renderer.js",
      "styles.css",
      "pomodoro-widget.html",
      "pomodoro-widget.js",
      "itsuki.html",
      "itsuki.js",
      "assets/**/*",
      "icons/**/*",
      "logo-star.svg",
      "icon.svg"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Aurestar-Portable-${version}.${ext}"
    }
  }
}
